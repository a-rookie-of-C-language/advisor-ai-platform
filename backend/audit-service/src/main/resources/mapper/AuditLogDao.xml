<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.edu.cqut.advisorplatform.dao.AuditLogDao">
  <resultMap id="rm" type="cn.edu.cqut.advisorplatform.entity.AuditLogDO">
    <id column="id" property="id"/>
    <result column="user_id" property="userId"/>
    <result column="module" property="module"/>
    <result column="action" property="action"/>
    <result column="ip_address" property="ipAddress"/>
    <result column="description" property="description"/>
    <result column="trace_id" property="traceId"/>
    <result column="created_at" property="createdAt"/>
  </resultMap>
  <insert id="insert" useGeneratedKeys="true" keyProperty="id">INSERT INTO audit_log(user_id,module,action,ip_address,description,trace_id,created_at) VALUES(#{userId},#{module},#{action},#{ipAddress},#{description},#{traceId},NOW())</insert>
  <select id="findById" resultMap="rm">SELECT * FROM audit_log WHERE id=#{id}</select>
  <select id="findByConditions" resultMap="rm">SELECT * FROM audit_log WHERE 1=1 <if test="userId != null">AND user_id=#{userId}</if><if test="module != null and module != ''">AND module=#{module}</if><if test="action != null and action != ''">AND action=#{action}</if><if test="startTime != null">AND created_at &gt;= #{startTime}</if><if test="endTime != null">AND created_at &lt;= #{endTime}</if> ORDER BY created_at DESC LIMIT #{limit} OFFSET #{offset}</select>
  <select id="countByConditions" resultType="int">SELECT COUNT(*) FROM audit_log WHERE 1=1 <if test="userId != null">AND user_id=#{userId}</if><if test="module != null and module != ''">AND module=#{module}</if><if test="action != null and action != ''">AND action=#{action}</if><if test="startTime != null">AND created_at &gt;= #{startTime}</if><if test="endTime != null">AND created_at &lt;= #{endTime}</if></select>
  <select id="countByUserAndModule" resultType="long">SELECT COUNT(*) FROM audit_log WHERE user_id=#{userId} AND module=#{module}</select>
  <select id="countByUserAndModuleAndAction" resultType="long">SELECT COUNT(*) FROM audit_log WHERE user_id=#{userId} AND module=#{module} AND action=#{action}</select>
</mapper>
